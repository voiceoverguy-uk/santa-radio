# HTTPS backend with the new native API; no path or trailing slash.
EXPO_PUBLIC_SANTA_API_URL=https://your-verified-backend.example
# RevenueCat public Apple SDK key only, never a server secret.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# Disabled by default. Only enable for the documented Apple sandbox setup.
EXPO_PUBLIC_SANTA_IAP_SANDBOX=false
