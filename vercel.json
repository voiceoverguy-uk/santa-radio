{
  "buildCommand": "npm run build",
  "installCommand": "node scripts/check-dependency-portability.mjs && npm ci",
  "outputDirectory": "dist",
  "framework": "vite",
  "crons": [
    { "path": "/api/santa-studio-email-retry", "schedule": "*/5 * * * *" }
  ],
  "functions": {
    "api/names-demo.js": {
      "installCommand": "",
      "maxDuration": 15,
      "includeFiles": "server/names-demo/{page.html,asset-manifest.json,assets/**}"
    },
    "api/santa-mobile.js": {
      "installCommand": "",
      "maxDuration": 120,
      "includeFiles": "{server/santa-audio/**,scripts/santa-audio-*.mjs,node_modules/ffmpeg-static/**}"
    },
    "api/santa-studio-message.js": {
      "installCommand": "",
      "maxDuration": 120,
      "includeFiles": "{server/santa-audio/studio/**,server/santa-audio/names/**,server/santa-audio/sleighbells.mp3,node_modules/ffmpeg-static/**}"
    },
    "api/santa-message-access.js": { "installCommand": "", "maxDuration": 20 },
    "api/stripe/webhook.js": { "installCommand": "", "maxDuration": 30 },
    "api/santa-studio-access.js": { "installCommand": "", "maxDuration": 30 },
    "api/santa-studio-checkout.js": { "installCommand": "", "maxDuration": 30 },
    "api/santa-studio-return.js": { "installCommand": "", "maxDuration": 30 },
    "api/santa-studio-email-retry.js": { "installCommand": "", "maxDuration": 60 },
    "api/public-page.js": {
      "installCommand": "",
      "includeFiles": "{dist/server/**,src/data/legacy-songs.js}"
    },
    "api/santa-message.js": {
      "installCommand": "",
      "maxDuration": 120,
      "includeFiles": "{server/santa-audio/**,server/santa-message.js,server/santa-name-library.js,scripts/santa-audio-*.mjs,scripts/prepare-santa-audio.mjs,node_modules/ffmpeg-static/**}"
    },
    "api/santa-greeting.js": {
      "installCommand": "",
      "maxDuration": 20,
      "includeFiles": "{server/santa-audio/**,server/santa-message.js,server/santa-name-library.js,scripts/santa-audio-*.mjs,scripts/prepare-santa-audio.mjs,node_modules/ffmpeg-static/package.json}"
    },
    "api/santa-names.js": {
      "installCommand": "",
      "maxDuration": 15
    },
    "api/santa-name-preview.js": {
      "installCommand": "",
      "maxDuration": 20
    },
    "api/santa-workshop-catalogue.js": {
      "installCommand": "",
      "maxDuration": 15
    },
    "api/santa-workshop-access.js": {
      "installCommand": "",
      "maxDuration": 20
    },
    "api/**/*.js": { "installCommand": "" }
  },
  "routes": [
    { "src": "/names", "dest": "/api/names-demo" },
    { "src": "/names-data/(names-[a-f0-9]{64}\\.json)", "dest": "/api/names-demo" },
    { "src": "/server/names-demo(?:/.*)?", "status": 404 },
    { "src": "/(.*)", "headers": {
      "X-Content-Type-Options": "nosniff",
      "Referrer-Policy": "strict-origin-when-cross-origin",
      "Content-Security-Policy": "base-uri 'self'; object-src 'none'; frame-ancestors 'self' https://replit.com https://*.replit.com https://*.replit.dev"
    }, "continue": true },
    { "src": "/api/__clerk/(.*)", "dest": "/api/__clerk/[...path]" },
    { "src": "/(request-names|sign-in|sign-up)(/.*)?", "dest": "/api/public-page?__sr_route=/$1$2" },
    { "src": "/artist-artwork/(.*)", "headers": {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "GET, HEAD, OPTIONS",
      "Cache-Control": "no-cache",
      "X-Content-Type-Options": "nosniff"
    }, "continue": true },
    { "src": "/server(?:/.*)?", "dest": "/api/public-page?__sr_route=/404" },
    { "src": "/christmas-karaoke-lyrics/163-shane-macgowan-(?:&|%26)-popes-christmas-lullaby", "dest": "/api/public-page?__sr_route=/christmas-karaoke-lyrics/163-shane-macgowan-%26-popes-christmas-lullaby" },
    { "src": "/christmas-karaoke-lyrics/231-bonnie-raitt-(?:&|%26)-charles-brown-merry-christmas-baby", "dest": "/api/public-page?__sr_route=/christmas-karaoke-lyrics/231-bonnie-raitt-%26-charles-brown-merry-christmas-baby" },
    { "src": "/christmas-karaoke-lyrics/5-tom-jones-(?:&|%26)-c-matthews-baby-its-cold-outside", "dest": "/api/public-page?__sr_route=/christmas-karaoke-lyrics/5-tom-jones-%26-c-matthews-baby-its-cold-outside" },
    { "src": "/christmas-artist/285-graham-parker-(?:&|%26)-nona-hendryx-soul-christmas", "dest": "/api/public-page?__sr_route=/christmas-artist/285-graham-parker-%26-nona-hendryx-soul-christmas" },
    { "src": "/christmas-artist/538-sia-naughty-(?:&|%26)-nice", "dest": "/api/public-page?__sr_route=/christmas-artist/538-sia-naughty-%26-nice" },
    { "src": "/christmas-artist/158-tom-petty-(?:&|%26)-heartbreakers-christmas-all-over-again", "dest": "/api/public-page?__sr_route=/christmas-artist/158-tom-petty-%26-heartbreakers-christmas-all-over-again" },
    { "src": "/christmas-karaoke-lyrics/139-paul-mccartney-(?:&|%26)-wings-mull-of-kintyre", "dest": "/api/public-page?__sr_route=/christmas-karaoke-lyrics/139-paul-mccartney-%26-wings-mull-of-kintyre" },
    { "src": "/christmas-artist/410-hall-(?:&|%26)-oates-jingle-bell-rock", "dest": "/api/public-page?__sr_route=/christmas-artist/410-hall-%26-oates-jingle-bell-rock" },
    { "src": "/christmas-artist/111-frank-sinatra-(?:&|%26)-cyndi-lauper-santa-claus-is-coming-to-town", "dest": "/api/public-page?__sr_route=/christmas-artist/111-frank-sinatra-%26-cyndi-lauper-santa-claus-is-coming-to-town" },
    { "src": "/((?:apps|privacy-policy|photo-usage-and-licensing|christmas-music|mugshots|christmas-artist|christmas-karaoke-lyrics|free-santa-message|santa-message-workshop|personalised-santa-message|submit-a-song|links|santa-stories|santa-tracker|naughty-or-nice-list-checker|music|artist)(?:/.*)?|)", "dest": "/api/public-page?__sr_route=/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/public-page?__sr_route=/$1" }
  ]
}
