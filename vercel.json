{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/public-page.js": {
      "includeFiles": "{dist/server/**,src/data/legacy-songs.js}"
    },
    "api/santa-message.js": {
      "maxDuration": 120,
      "includeFiles": "{server/santa-audio/**,server/santa-message.js,server/santa-name-library.js,scripts/santa-audio-*.mjs,scripts/prepare-santa-audio.mjs,node_modules/ffmpeg-static/**}"
    },
    "api/santa-greeting.js": {
      "maxDuration": 20,
      "includeFiles": "{server/santa-audio/**,server/santa-message.js,server/santa-name-library.js,scripts/santa-audio-*.mjs,scripts/prepare-santa-audio.mjs,node_modules/ffmpeg-static/package.json}"
    },
    "api/santa-names.js": {
      "maxDuration": 15
    },
    "api/santa-workshop-catalogue.js": {
      "maxDuration": 15
    },
    "api/santa-workshop-access.js": {
      "maxDuration": 20
    }
  },
  "routes": [
    { "src": "/api/__clerk/(.*)", "dest": "/api/__clerk/[...path]" },
    { "src": "/artist-artwork/(.*)", "headers": {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "GET, HEAD, OPTIONS",
      "Cache-Control": "no-cache",
      "X-Content-Type-Options": "nosniff"
    }, "continue": true },
    { "src": "/server(?:/.*)?", "dest": "/api/public-page?__sr_route=/404" },
    { "src": "/((?:apps|privacy-policy|christmas-music|mugshots|christmas-artist|christmas-karaoke-lyrics|free-santa-message|santa-message-workshop|personalised-santa-message|submit-a-song|links|santa-stories|santa-tracker|music|artist)(?:/.*)?|)", "dest": "/api/public-page?__sr_route=/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/public-page?__sr_route=/$1" }
  ]
}
