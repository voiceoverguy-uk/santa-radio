{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/santa-message.js": {
      "maxDuration": 120,
      "includeFiles": "{server/santa-audio/**,scripts/santa-audio-filters.mjs,node_modules/ffmpeg-static/**}"
    }
  },
  "headers": [
    { "source": "/santa-tracker/preview", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/santa-tracker/preview/", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] }
  ],
  "rewrites": [
    { "source": "/api/radio-metadata", "destination": "/api/radio-metadata" },
    { "source": "/api/santa-message", "destination": "/api/santa-message" },
    { "source": "/santa-tracker", "destination": "/santa-tracker/index.html" },
    { "source": "/santa-tracker/preview", "destination": "/santa-tracker/preview/index.html" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
