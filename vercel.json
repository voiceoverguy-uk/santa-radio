{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/public-page.js": {
      "includeFiles": "{dist/server/**,src/data/legacy-songs.js}"
    },
    "api/santa-message.js": {
      "maxDuration": 120,
      "includeFiles": "{server/santa-audio/**,scripts/santa-audio-filters.mjs,node_modules/ffmpeg-static/**}"
    },
    "api/santa-names.js": {
      "maxDuration": 15
    }
  },
  "routes": [
    { "src": "/artist-artwork/(.*)", "headers": {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "GET, HEAD, OPTIONS",
      "Cache-Control": "no-cache",
      "X-Content-Type-Options": "nosniff"
    }, "continue": true },
    { "src": "/server(?:/.*)?", "dest": "/api/public-page?__sr_route=/404" },
    { "src": "/((?:apps|privacy-policy|christmas-music|mugshots|christmas-artist|christmas-karaoke-lyrics|free-santa-message|personalised-santa-message|submit-a-song|links|santa-stories|santa-tracker|music|artist)(?:/.*)?|)", "dest": "/api/public-page?__sr_route=/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/public-page?__sr_route=/$1" }
  ]
}
