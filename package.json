{
  "name": "santa-radio",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "radio:collect": "node scripts/radio-history-collector.mjs",
    "test:radio-history": "node --test scripts/radio-history.test.mjs",
    "start": "node index.js",
    "dev": "node scripts/prepare-santa-audio.mjs && vite --host 0.0.0.0 --port 5000",
    "build": "node scripts/prepare-santa-audio.mjs && vite build && vite build --ssr src/entry-server.jsx --outDir dist/server && node scripts/build-public-pages.mjs",
    "preview": "vite preview",
    "test:artwork": "node --test scripts/artwork-feed.test.mjs",
    "test:artwork-production": "node --test scripts/artwork-feed-serving.test.mjs",
    "test:santa-audio": "node scripts/prepare-santa-audio.mjs && node --test scripts/santa-render.test.mjs scripts/santa-message-api.test.mjs",
    "test:e2e": "playwright test",
    "test:cookies": "playwright test tests/cookie-experience.spec.js",
    "test:apps-production": "node --test scripts/apps-production.test.mjs",
    "test:seo": "node --test scripts/seo-validation.test.mjs scripts/seo-serving.test.mjs scripts/seo-targeting.test.mjs scripts/santa-message-links.test.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.23.2",
    "@clerk/express": "^2.1.78",
    "@clerk/react": "^6.17.8",
    "@clerk/shared": "^4.40.0",
    "@clerk/themes": "^2.4.57",
    "@tailwindcss/vite": "^4.2.1",
    "basic-ftp": "^6.2.3",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "html-to-image": "^1.11.13",
    "http-proxy-middleware": "^4.2.0",
    "lucide-react": "^0.577.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.4"
  }
}
