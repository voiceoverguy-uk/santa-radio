{
  "name": "santa-radio",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "radio:collect": "node scripts/radio-history-collector.mjs",
    "test:mobile": "node --test scripts/santa-mobile.test.mjs scripts/santa-mobile-store.test.mjs",
    "test:radio-history": "node --test scripts/radio-history.test.mjs",
    "test:radio-ssr": "node --test scripts/radio-ssr.test.mjs",
    "start": "node index.js",
    "dev": "node scripts/prepare-names-demo.mjs && node scripts/prepare-santa-audio.mjs && vite --host 0.0.0.0 --port 5000 --strictPort",
    "names:demo:update": "node scripts/import-names-demo.mjs --confirm-update && node scripts/prepare-names-demo.mjs",
    "check:dependency-portability": "node scripts/check-dependency-portability.mjs",
    "test:dependency-portability": "node --test scripts/dependency-portability.test.mjs",
    "test:function-layout": "node --test scripts/vercel-function-layout.test.mjs",
    "test:private-name-search": "node --test scripts/santa-name-snapshot.test.mjs scripts/santa-name-recovery.test.mjs scripts/santa-name-library.test.mjs scripts/santa-name-security.test.mjs scripts/santa-name-count.test.mjs scripts/security-hardening.test.mjs scripts/santa-workshop-names.test.mjs",
    "benchmark:private-name-search": "node scripts/benchmark-private-name-search.mjs",
    "names:index:status": "node scripts/private-name-catalogue.mjs status",
    "names:index:refresh": "node scripts/private-name-catalogue.mjs refresh --confirm-refresh",
    "check:vercel-packaging": "npm exec --yes --package=@vercel/node@28.0.0 -- node scripts/check-vercel-packaging.mjs",
    "generate:section-share-images": "node scripts/generate-section-share-images.mjs",
    "prebuild": "npm run check:dependency-portability",
    "build": "node scripts/prepare-names-demo.mjs && node scripts/prepare-santa-audio.mjs && vite build && vite build --ssr src/entry-server.jsx --outDir dist/server && node scripts/build-public-pages.mjs",
    "check:studio-readiness": "node scripts/check-studio-release.mjs",
    "check:studio-live-readiness": "node scripts/check-studio-live-release.mjs",
    "test:studio-live": "node --test scripts/studio-live.test.mjs scripts/studio-live-setup.test.mjs",
    "preview": "vite preview",
    "test:artwork": "node --test scripts/artwork-feed.test.mjs scripts/artwork-feed-development.test.mjs",
    "test:artwork-production": "node --test scripts/artwork-feed-serving.test.mjs",
    "test:santa-audio": "node scripts/prepare-santa-audio.mjs && node --test --test-concurrency=1 scripts/santa-render.test.mjs scripts/hosted-santa-render.test.mjs scripts/santa-message-api.test.mjs scripts/santa-free-ending.test.mjs scripts/saved-santa-greeting.test.mjs scripts/santa-ftps.test.mjs scripts/santa-message-allowance.test.mjs",
    "test:e2e": "playwright test",
    "test:name-security": "node --test scripts/santa-name-security.test.mjs scripts/santa-workshop-names.test.mjs scripts/workshop-name-preview.test.mjs scripts/santa-name-library.test.mjs",
    "test:security-hardening": "node --test scripts/security-hardening.test.mjs scripts/santa-name-security.test.mjs",
    "test:name-security:e2e": "playwright test tests/santa-name-security.spec.js --project=chromium",
    "test:workshop-access": "node --test scripts/santa-workshop-access.test.mjs",
    "test:workshop-usage": "node --test scripts/santa-workshop-usage.test.mjs",
    "workshop:preflight": "node scripts/workshop-access-preflight.mjs",
    "test:workshop": "playwright test --config playwright.workshop.config.js",
    "test:studio-audio": "node --test scripts/santa-studio-message.test.mjs scripts/santa-studio-generation.test.mjs scripts/studio-creation-allowance.test.mjs scripts/studio-selection-identity.test.mjs scripts/studio-source-recordings.test.mjs",
    "test:cookies": "playwright test tests/cookie-experience.spec.js",
    "test:apps-production": "node --test scripts/apps-production.test.mjs",
    "test:footer-production": "node --test scripts/footer-production.test.mjs",
    "test:studio-promotion-production": "node --test scripts/studio-promotion-production.test.mjs",
    "audit:discovered": "node scripts/audit-discovered-pages.mjs --live",
    "report:discovered": "node scripts/report-discovered-pages.mjs",
    "test:discovered": "node --test --test-concurrency=1 scripts/discovered-pages.test.mjs",
    "test:seo": "node --test scripts/seo-validation.test.mjs scripts/mugshot-supplied-profiles.test.mjs scripts/seo-serving.test.mjs scripts/seo-targeting.test.mjs scripts/santa-message-links.test.mjs scripts/search-console-legacy.test.mjs scripts/search-console-duplicate.test.mjs scripts/search-console-alternate.test.mjs scripts/discovered-pages.test.mjs scripts/search-console-crawled.test.mjs scripts/search-console-missing.test.mjs",
    "test:staff-production": "node --test scripts/staff-production.test.mjs && node --test --test-name-pattern=deployment-style scripts/seo-serving.test.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.23.2",
    "@clerk/express": "^2.1.78",
    "@clerk/react": "^6.17.8",
    "@clerk/shared": "^4.40.0",
    "@clerk/themes": "^2.4.57",
    "@pdf-lib/fontkit": "^1.1.1",
    "@replit/connectors-sdk": "^0.5.0",
    "@replit/revenuecat-sdk": "^5.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "basic-ftp": "^6.2.3",
    "body-parser": "^2.4.0",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "html-to-image": "^1.11.13",
    "http-proxy-middleware": "^4.2.0",
    "lucide-react": "^0.577.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qs": "^6.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router": "7.18.5",
    "react-router-dom": "^7.18.5",
    "stripe": "^23.0.1",
    "stripe-replit-sync": "^1.0.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.5"
  }
}
