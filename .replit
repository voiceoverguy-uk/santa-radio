entrypoint = "index.js"
modules = ["nodejs-22", "python-base-3.13", "postgresql-16"]
hidden = [".config", "package-lock.json"]

[gitHubImport]
requiredFiles = [".replit", "replit.nix", "package.json", "package-lock.json"]

[nix]
channel = "stable-24_11"
packages = ["ffmpeg", "imagemagick", "xorg.libXrandr", "xorg.libXcomposite", "xorg.libXcursor", "xorg.libXdamage", "xorg.libXi", "xorg.libXext", "xorg.libXfixes", "gtk3", "pango", "atk", "cairo", "gdk-pixbuf", "glib", "xorg.libXrender", "alsa-lib", "dbus"]

[deployment]
run = ["npm", "start"]
deploymentTarget = "autoscale"
ignorePorts = false
build = ["npm", "run", "build"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "santa-ios"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "santa-website-build"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "vercel-function-layout"

[[workflows.workflow]]
name = "santa-ios"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run test:mobile && pnpm --filter @workspace/santa-radio-ios run typecheck && pnpm --filter @workspace/santa-radio-ios test && pnpm --filter @workspace/santa-radio-ios run export:ios"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "santa-website-build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run build"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "vercel-function-layout"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run test:function-layout && npm run test:dependency-portability"

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000
exposeLocalhost = true

[[ports]]
localPort = 5012
externalPort = 4200

[[ports]]
localPort = 5055
externalPort = 3003

[[ports]]
localPort = 5087
externalPort = 5000

[[ports]]
localPort = 5095
externalPort = 5173

[[ports]]
localPort = 24678
externalPort = 3001

[[ports]]
localPort = 24826
externalPort = 6800
exposeLocalhost = true

[[ports]]
localPort = 24827
externalPort = 3002

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[userenv]

[userenv.shared]
SANTA_REQUEST_ADMIN_EMAILS = "admin@santaradio.co.uk"
SANTA_STUDIO_TEST_EXPIRES_AT = "2026-11-30T23:59:59Z"
REVENUECAT_APPLE_APP_STORE_APP_ID = "appb4b894a6e8"
REVENUECAT_PROJECT_ID = "projedf58122"

[userenv.development]
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY = "appl_XtHePQmslaCzsEMooYQWxONQOKt"
EXPO_PUBLIC_SANTA_IAP_SANDBOX = "false"
