entrypoint = "index.js"
modules = ["nodejs-22", "python-base-3.13", "postgresql-16"]
hidden = [".config", "package-lock.json"]

[gitHubImport]
requiredFiles = [".replit", "replit.nix", "package.json", "package-lock.json"]

[nix]
channel = "stable-24_11"
packages = ["ffmpeg", "imagemagick"]

[deployment]
run = ["npm", "start"]
deploymentTarget = "autoscale"
ignorePorts = false
build = ["npm", "run", "build"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 5012
externalPort = 4200

[[ports]]
localPort = 5055
externalPort = 3003

[[ports]]
localPort = 5087
externalPort = 5000

[[ports]]
localPort = 24678
externalPort = 3001

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[userenv]

[userenv.shared]
SANTA_REQUEST_ADMIN_EMAILS = "admin@santaradio.co.uk"
SANTA_STUDIO_TEST_EXPIRES_AT = "2026-11-30T23:59:59Z"
